---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { slideBlur } from '../lib/transitions';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Open Loop — interactive science & engineering tinkering.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Open Loop</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.dataset.theme = stored;
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <div class="transition-root" transition:name="page-root" transition:animate={slideBlur}>
      <header class="site-header">
        <div class="container site-header__inner">
          <a class="wordmark" href={import.meta.env.BASE_URL}>Open Loop</a>
          <nav class="ui">
            <a href={import.meta.env.BASE_URL}>Widgets</a>
            <a href={`${import.meta.env.BASE_URL}suggest/`}>Suggest &amp; vote</a>
            <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle color theme">
              <span aria-hidden="true">◐</span>
            </button>
          </nav>
        </div>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer ui">
        <div class="container">
          <p>Open Loop — a wandering mind, no feedback correction. Built in the open.</p>
        </div>
      </footer>
    </div>
  </body>
</html>

<script>
  // With the ClientRouter, this module only executes once -- navigations
  // swap in a fresh DOM without re-running already-loaded scripts. Bind on
  // astro:page-load (fires on first load too) so the listener always
  // attaches to whichever #theme-toggle is currently in the document.
  function setup() {
    const btn = document.getElementById('theme-toggle') as HTMLButtonElement | null;
    if (!btn) return;
    const icon = btn.querySelector('span') as HTMLElement;

    function effectiveTheme(): 'light' | 'dark' {
      const stored = document.documentElement.dataset.theme;
      if (stored === 'light' || stored === 'dark') return stored;
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }

    function reflect() {
      const theme = effectiveTheme();
      icon.textContent = theme === 'dark' ? '☀' : '☾';
      btn!.setAttribute('aria-label', theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
    }

    btn.addEventListener('click', () => {
      const next: 'light' | 'dark' = effectiveTheme() === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('theme', next);
      reflect();
    });

    reflect();
  }

  document.addEventListener('astro:page-load', setup);
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--hairline);
  }
  .site-header__inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
  }
  .wordmark {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--ink);
    text-decoration: none;
  }
  nav {
    display: flex;
    gap: 1.5rem;
  }
  nav a {
    color: var(--ink-secondary);
    text-decoration: none;
    font-size: 0.9rem;
  }
  nav a:hover {
    color: var(--accent);
  }
  .theme-toggle {
    background: transparent;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    width: 1.75rem;
    height: 1.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
    line-height: 1;
    color: var(--ink-secondary);
    cursor: pointer;
    padding: 0;
  }
  .theme-toggle:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .site-footer {
    border-top: 1px solid var(--hairline);
    margin-top: 4rem;
    padding: 2rem 0;
    color: var(--ink-muted);
    font-size: 0.85rem;
  }
</style>
