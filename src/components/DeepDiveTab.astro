---
interface Props {
  href: string;
  label?: string;
}

const { href, label = 'Go deeper' } = Astro.props;
---

<a href={href} class="deep-dive-tab ui" aria-label={`${label}: advanced technical detail`}>
  <span class="deep-dive-tab__label">{label}</span>
  <span class="deep-dive-tab__chevron" aria-hidden="true">&rsaquo;</span>
</a>

<style>
  .deep-dive-tab {
    position: fixed;
    right: 0;
    top: 50%;
    transform: translate(0.9rem, -50%);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-right: none;
    border-radius: 999px 0 0 999px;
    padding: 0.55rem 1.1rem 0.55rem 0.9rem;
    color: var(--ink-secondary);
    text-decoration: none;
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    box-shadow: -2px 2px 10px rgba(11, 11, 11, 0.06);
    transition: transform 0.18s ease, color 0.18s ease, border-color 0.18s ease;
    z-index: 20;
  }
  .deep-dive-tab:hover,
  .deep-dive-tab:focus-visible {
    transform: translate(0, -50%);
    color: var(--accent);
    border-color: var(--accent);
  }
  .deep-dive-tab__label {
    writing-mode: vertical-rl;
    text-orientation: mixed;
    transform: rotate(180deg);
    text-transform: uppercase;
  }
  .deep-dive-tab__chevron {
    font-size: 1.1rem;
    line-height: 1;
  }
</style>
