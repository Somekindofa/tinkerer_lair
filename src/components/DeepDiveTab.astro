---
interface Props {
  href: string;
  label?: string;
}

const { href, label = 'Go deeper' } = Astro.props;
---

<a href={href} class="deep-dive-tab ui" aria-label={`${label}: advanced technical detail`}>
  <span class="deep-dive-tab__label">{label}</span>
  <span class="deep-dive-tab__chevron" aria-hidden="true">&rsaquo;</span>
</a>

<style>
  .deep-dive-tab {
    position: fixed;
    right: 0;
    top: 50%;
    /* Peeks 0.9rem off-screen at rest and slides fully into view on
       hover/focus below -- but touch devices have no hover, so that resting
       state would be permanently, uselessly half-offscreen there. Only
       apply the peek on devices that can actually reveal it. */
    transform: translate(0, -50%);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--surface);
    border: 1px solid var(--accent);
    border-right: none;
    border-radius: 999px 0 0 999px;
    padding: 0.55rem 1.1rem 0.55rem 0.9rem;
    color: var(--ink-secondary);
    text-decoration: none;
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    box-shadow: -2px 2px 10px rgba(11, 11, 11, 0.06), inset 2px 0 0 var(--accent);
    transition: transform 0.18s ease, color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
    z-index: 20;
  }
  @media (hover: hover) and (pointer: fine) {
    .deep-dive-tab {
      transform: translate(0.9rem, -50%);
    }
  }
  .deep-dive-tab:hover,
  .deep-dive-tab:focus-visible {
    transform: translate(0, -50%);
    color: var(--accent-ink);
    background: var(--accent);
    box-shadow: -2px 2px 14px rgba(11, 11, 11, 0.14), inset 2px 0 0 var(--accent);
  }
  .deep-dive-tab__label {
    writing-mode: vertical-rl;
    text-orientation: mixed;
    transform: rotate(180deg);
    text-transform: uppercase;
  }
  .deep-dive-tab__chevron {
    font-size: 1.1rem;
    line-height: 1;
    color: var(--accent);
    transition: color 0.18s ease;
  }
  .deep-dive-tab:hover .deep-dive-tab__chevron,
  .deep-dive-tab:focus-visible .deep-dive-tab__chevron {
    color: var(--accent-ink);
  }
</style>
