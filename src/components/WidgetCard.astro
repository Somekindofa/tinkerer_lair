---
import type { CollectionEntry } from 'astro:content';

interface Props {
  widget: CollectionEntry<'widgets'>;
}

const { widget } = Astro.props;
const href = `${import.meta.env.BASE_URL}widgets/${widget.slug}/`;
---

<a class="card" href={href} data-tags={widget.data.tags.join(',')}>
  <h3>{widget.data.title}</h3>
  <p class="meta">{widget.data.description}</p>
  <ul class="tag-list ui">
    {widget.data.tags.map((tag: string) => <li class="tag">{tag}</li>)}
  </ul>
</a>

<style>
  .card {
    display: block;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 1.25rem;
    text-decoration: none;
    color: var(--ink);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .card h3 {
    margin: 0 0 0.4rem;
    font-size: 1.05rem;
  }
  .card .meta {
    margin: 0 0 0.75rem;
    color: var(--ink-secondary);
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tag {
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ink-muted);
    border: 1px solid var(--hairline);
    border-radius: 999px;
    padding: 0.15rem 0.55rem;
  }
</style>
