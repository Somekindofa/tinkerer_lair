---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WidgetCard from '../components/WidgetCard.astro';
import TagFilter from '../components/TagFilter.astro';

const widgets = (await getCollection('widgets')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const featured = widgets.find((w) => w.data.featured) ?? widgets[0];
const rest = widgets.filter((w) => w.slug !== featured?.slug);
const allTags = [...new Set(widgets.flatMap((w) => w.data.tags))].sort();
---

<BaseLayout title="Widgets">
  <section class="hero container">
    <p class="ui eyebrow">This week's pick</p>
    {featured && (
      <a class="hero__link" href={`${import.meta.env.BASE_URL}widgets/${featured.slug}/`}>
        <h1>{featured.data.title}</h1>
        <p>{featured.data.description}</p>
      </a>
    )}
  </section>

  <section class="container">
    <TagFilter tags={allTags} />
    <div class="grid">
      {rest.map((widget) => <WidgetCard widget={widget} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 3rem 1.5rem 2rem;
    border-bottom: 1px solid var(--hairline);
    margin-bottom: 2rem;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.78rem;
    color: var(--accent);
    margin: 0 0 0.5rem;
  }
  .hero__link {
    text-decoration: none;
    color: var(--ink);
    display: block;
  }
  .hero__link h1 {
    font-size: 2rem;
    margin: 0 0 0.5rem;
  }
  .hero__link p {
    color: var(--ink-secondary);
    max-width: 40rem;
    margin: 0;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 1rem;
    padding-bottom: 3rem;
  }
</style>
