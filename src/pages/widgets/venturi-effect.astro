---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entry = await getEntry('widgets', 'venturi-effect');
if (!entry) throw new Error('Missing venturi-effect content entry');
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article class="prose widget-article">
    <p class="ui eyebrow">{entry.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</p>
    <h1>{entry.data.title}</h1>
    <Content />
  </article>

  <section class="widget-stage container">
    <canvas id="venturi-canvas" aria-label="Venturi effect flow simulation"></canvas>
    <div class="controls ui">
      <label for="constriction">Throat width</label>
      <input id="constriction" type="range" min="0" max="1" step="0.01" value="0.55" />
    </div>
    <p class="ui live-label">Live, from the equations above:</p>
    <div class="live-equations">
      <div id="continuity-eq" class="live-eq"></div>
      <div id="bernoulli-eq" class="live-eq"></div>
    </div>
  </section>
</BaseLayout>

<script>
  import { mount } from '../../islands/venturi-effect';

  const canvas = document.getElementById('venturi-canvas') as HTMLCanvasElement;
  const slider = document.getElementById('constriction') as HTMLInputElement;
  const continuityOut = document.getElementById('continuity-eq') as HTMLElement;
  const bernoulliOut = document.getElementById('bernoulli-eq') as HTMLElement;

  mount({ canvas, slider, continuityOut, bernoulliOut });
</script>

<style>
  .widget-article {
    padding-top: 2.5rem;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.78rem;
    color: var(--accent);
    margin: 0 0 0.5rem;
  }
  .widget-stage {
    padding: 2rem 1.5rem 4rem;
  }
  #venturi-canvas {
    display: block;
    width: 100%;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
  }
  .controls {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1rem;
    font-size: 0.85rem;
    color: var(--ink-secondary);
  }
  .controls input[type='range'] {
    flex: 1;
    min-width: 10rem;
    accent-color: var(--accent);
  }
  .live-label {
    margin: 1.5rem 0 0.5rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-muted);
  }
  .live-equations {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1rem;
  }
  .live-eq {
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 0.75rem 1rem;
    overflow-x: auto;
  }
  .live-eq .katex-display {
    margin: 0;
  }
</style>
