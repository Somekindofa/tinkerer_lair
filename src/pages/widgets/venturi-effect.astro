---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DeepDiveTab from '../../components/DeepDiveTab.astro';

const entry = await getEntry('widgets', 'venturi-effect');
if (!entry) throw new Error('Missing venturi-effect content entry');
const { Content } = await render(entry);
const deepDive = await getEntry('deepDives', 'venturi-effect');

const dateFmt: Intl.DateTimeFormatOptions = { month: 'long', day: 'numeric', year: 'numeric' };
const published = entry.data.date.toLocaleDateString('en-US', dateFmt);
const updated = entry.data.updated?.toLocaleDateString('en-US', dateFmt);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article class="prose widget-article">
    <p class="ui eyebrow">
      {published}
      {updated && <span class="updated"> · Last updated {updated}</span>}
    </p>
    <h1>{entry.data.title}</h1>
    <Content />
  </article>

  <section class="widget-stage container">
    <canvas id="venturi-canvas" aria-label="Venturi effect flow simulation"></canvas>

    <div class="controls ui">
      <div class="control-row">
        <label for="v1">Inlet speed (v₁)</label>
        <input id="v1" type="range" min="30" max="150" step="1" value="90" />
      </div>
      <div class="control-row">
        <label for="a1">Inlet area (A₁)</label>
        <input id="a1" type="range" min="20" max="100" step="1" value="80" />
      </div>
      <div class="control-row">
        <label for="a2">Throat area (A₂)</label>
        <input id="a2" type="range" min="10" max="100" step="1" value="50" />
      </div>
    </div>

    <p class="ui live-label">Live, from the equations above:</p>
    <div class="live-equations">
      <div id="continuity-eq" class="live-eq"></div>
      <div id="bernoulli-eq" class="live-eq"></div>
    </div>
  </section>

  {deepDive && <DeepDiveTab href={`${import.meta.env.BASE_URL}widgets/venturi-effect/going-further/`} />}
</BaseLayout>

<script>
  import { mount } from '../../islands/venturi-effect';

  // With the ClientRouter, this module only executes once -- re-mount on
  // every astro:page-load (fires on first load too), tearing down the prior
  // animation loop first so returning to this page via back/forward doesn't
  // stack up rAF loops and resize listeners against a detached canvas.
  let destroy: (() => void) | undefined;

  function setup() {
    destroy?.();

    const canvas = document.getElementById('venturi-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    const v1Slider = document.getElementById('v1') as HTMLInputElement;
    const a1Slider = document.getElementById('a1') as HTMLInputElement;
    const a2Slider = document.getElementById('a2') as HTMLInputElement;
    const continuityOut = document.getElementById('continuity-eq') as HTMLElement;
    const bernoulliOut = document.getElementById('bernoulli-eq') as HTMLElement;

    destroy = mount({ canvas, v1Slider, a1Slider, a2Slider, continuityOut, bernoulliOut });
  }

  document.addEventListener('astro:page-load', setup);
</script>

<style>
  .widget-article {
    padding-top: 2.5rem;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.78rem;
    color: var(--accent);
    margin: 0 0 0.5rem;
  }
  .eyebrow .updated {
    color: var(--ink-muted);
  }
  .widget-stage {
    padding: 2rem 1.5rem 4rem;
  }
  #venturi-canvas {
    display: block;
    width: 100%;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
  }
  .controls {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: 1.25rem;
    font-size: 0.85rem;
    color: var(--ink-secondary);
  }
  .control-row {
    display: grid;
    grid-template-columns: 9rem 1fr;
    align-items: center;
    gap: 0.75rem;
  }
  .controls input[type='range'] {
    width: 100%;
    accent-color: var(--accent);
  }
  .live-label {
    margin: 1.5rem 0 0.5rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-muted);
  }
  .live-equations {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1rem;
  }
  .live-eq {
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 0.75rem 1rem;
    overflow-x: auto;
  }
  .live-eq .katex-display {
    margin: 0;
  }
</style>
