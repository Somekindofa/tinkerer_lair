---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DeepDiveTab from '../../components/DeepDiveTab.astro';

const entry = await getEntry('widgets', 'venturi-effect');
if (!entry) throw new Error('Missing venturi-effect content entry');
const { Content } = await render(entry);
const deepDive = await getEntry('deepDives', 'venturi-effect');

const dateFmt: Intl.DateTimeFormatOptions = { month: 'long', day: 'numeric', year: 'numeric' };
const published = entry.data.date.toLocaleDateString('en-US', dateFmt);
const updated = entry.data.updated?.toLocaleDateString('en-US', dateFmt);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article class="prose widget-article">
    <p class="ui eyebrow">
      {published}
      {updated && <span class="updated"> · Last updated {updated}</span>}
    </p>
    <h1>{entry.data.title}</h1>
    <Content />
  </article>

  <section class="widget-stage container">
    <canvas id="venturi-canvas" aria-label="Venturi effect flow simulation"></canvas>

    <div class="controls ui">
      <div class="control-card control-card--speed">
        <div class="control-card__head">
          <label for="v1" class="control-card__label">Inlet speed</label>
          <output id="v1-value" for="v1" class="control-card__value"><span class="num">90</span><span class="unit">m/s</span></output>
        </div>
        <input id="v1" class="control-slider" type="range" min="30" max="150" step="1" value="90" />
      </div>
      <div class="control-card">
        <div class="control-card__head">
          <label for="a1" class="control-card__label">Inlet area (A₁)</label>
          <output id="a1-value" for="a1" class="control-card__value"><span class="num">80</span><span class="unit">cm²</span></output>
        </div>
        <input id="a1" class="control-slider" type="range" min="20" max="100" step="1" value="80" />
      </div>
      <div class="control-card">
        <div class="control-card__head">
          <label for="a2" class="control-card__label">Throat area (A₂)</label>
          <output id="a2-value" for="a2" class="control-card__value"><span class="num">50</span><span class="unit">cm²</span></output>
        </div>
        <input id="a2" class="control-slider" type="range" min="10" max="100" step="1" value="50" />
      </div>
    </div>

    <p class="ui live-label">Live, from the equations above:</p>
    <div class="live-equations">
      <div id="continuity-eq" class="live-eq"></div>
      <div id="bernoulli-eq" class="live-eq"></div>
    </div>
  </section>

  {deepDive && <DeepDiveTab href={`${import.meta.env.BASE_URL}widgets/venturi-effect/going-further/`} />}
</BaseLayout>

<script>
  import { mount } from '../../islands/venturi-effect';

  // With the ClientRouter, this module only executes once -- re-mount on
  // every astro:page-load (fires on first load too), tearing down the prior
  // animation loop first so returning to this page via back/forward doesn't
  // stack up rAF loops and resize listeners against a detached canvas.
  let destroy: (() => void) | undefined;

  function setup() {
    destroy?.();

    const canvas = document.getElementById('venturi-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    const v1Slider = document.getElementById('v1') as HTMLInputElement;
    const a1Slider = document.getElementById('a1') as HTMLInputElement;
    const a2Slider = document.getElementById('a2') as HTMLInputElement;
    const v1ValueOut = document.getElementById('v1-value') as HTMLElement;
    const a1ValueOut = document.getElementById('a1-value') as HTMLElement;
    const a2ValueOut = document.getElementById('a2-value') as HTMLElement;
    const continuityOut = document.getElementById('continuity-eq') as HTMLElement;
    const bernoulliOut = document.getElementById('bernoulli-eq') as HTMLElement;

    destroy = mount({
      canvas,
      v1Slider,
      a1Slider,
      a2Slider,
      v1ValueOut,
      a1ValueOut,
      a2ValueOut,
      continuityOut,
      bernoulliOut,
    });
  }

  document.addEventListener('astro:page-load', setup);
</script>

<style>
  .widget-article {
    padding-top: 2.5rem;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.78rem;
    color: var(--accent);
    margin: 0 0 0.5rem;
  }
  .eyebrow .updated {
    color: var(--ink-muted);
  }
  .widget-stage {
    padding: 2rem 1.5rem 4rem;
  }
  #venturi-canvas {
    display: block;
    width: 100%;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
  }
  .controls {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .control-card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: 1rem 1.1rem 1.15rem;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }
  .control-card:hover,
  .control-card:focus-within {
    border-color: var(--accent);
    box-shadow: 0 4px 16px rgba(11, 11, 11, 0.08);
    transform: translateY(-1px);
  }
  .control-card__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .control-card__label {
    font-size: 0.78rem;
    color: var(--ink-secondary);
  }
  .control-card__value {
    font-family: var(--font-sans);
    font-variant-numeric: tabular-nums;
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--accent);
    white-space: nowrap;
    transition: color 0.15s ease;
  }
  .control-card__value .unit {
    margin-left: 0.25rem;
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--ink-muted);
  }

  /* Custom range slider: a gradient-filled track (the fill percentage is
     set via the --fill custom property on 'input') and a larger, tactile
     thumb that grows on interaction -- default unstyled range inputs read
     as an afterthought, not a control worth touching. */
  .control-slider {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 6px;
    border-radius: 999px;
    background: linear-gradient(
      to right,
      var(--accent) 0%,
      var(--accent) var(--fill, 50%),
      var(--hairline) var(--fill, 50%),
      var(--hairline) 100%
    );
    outline: none;
    cursor: pointer;
    margin: 0.15rem 0 0.35rem;
  }
  .control-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 18px;
    height: 18px;
    margin-top: -6px;
    border-radius: 50%;
    background: var(--accent);
    border: 3px solid var(--surface);
    box-shadow: 0 1px 4px rgba(11, 11, 11, 0.3);
    cursor: grab;
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }
  .control-slider:hover::-webkit-slider-thumb {
    transform: scale(1.15);
  }
  .control-slider:active::-webkit-slider-thumb {
    cursor: grabbing;
    transform: scale(1.25);
    box-shadow: 0 2px 8px rgba(11, 11, 11, 0.4);
  }
  .control-slider::-moz-range-track {
    height: 6px;
    border-radius: 999px;
    background: var(--hairline);
  }
  .control-slider::-moz-range-progress {
    height: 6px;
    border-radius: 999px;
    background: var(--accent);
  }
  .control-slider::-moz-range-thumb {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--accent);
    border: 3px solid var(--surface);
    box-shadow: 0 1px 4px rgba(11, 11, 11, 0.3);
    cursor: grab;
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }
  .control-slider:hover::-moz-range-thumb {
    transform: scale(1.15);
  }
  .control-slider:active::-moz-range-thumb {
    cursor: grabbing;
    transform: scale(1.25);
  }
  .live-label {
    margin: 1.5rem 0 0.5rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-muted);
  }
  .live-equations {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1rem;
  }
  .live-eq {
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 0.75rem 1rem;
    overflow-x: auto;
  }
  .live-eq .katex-display {
    margin: 0;
  }
</style>
