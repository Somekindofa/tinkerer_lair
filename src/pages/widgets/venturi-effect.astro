---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entry = await getEntry('widgets', 'venturi-effect');
if (!entry) throw new Error('Missing venturi-effect content entry');
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article class="prose widget-article">
    <p class="ui eyebrow">{entry.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</p>
    <h1>{entry.data.title}</h1>
    <Content />
  </article>

  <section class="widget-stage container">
    <canvas id="venturi-canvas" aria-label="Venturi effect flow simulation"></canvas>
    <div class="controls ui">
      <label for="constriction">Throat width</label>
      <input id="constriction" type="range" min="0" max="1" step="0.01" value="0.55" />
      <div class="readouts">
        <span id="velocity-readout">—</span>
        <span id="pressure-readout">—</span>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { mount } from '../../islands/venturi-effect';

  const canvas = document.getElementById('venturi-canvas') as HTMLCanvasElement;
  const slider = document.getElementById('constriction') as HTMLInputElement;
  const velocityOut = document.getElementById('velocity-readout') as HTMLElement;
  const pressureOut = document.getElementById('pressure-readout') as HTMLElement;

  mount({ canvas, slider, velocityOut, pressureOut });
</script>

<style>
  .widget-article {
    padding-top: 2.5rem;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.78rem;
    color: var(--accent);
    margin: 0 0 0.5rem;
  }
  .widget-stage {
    padding: 2rem 1.5rem 4rem;
  }
  #venturi-canvas {
    display: block;
    width: 100%;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
  }
  .controls {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1rem;
    font-size: 0.85rem;
    color: var(--ink-secondary);
  }
  .controls input[type='range'] {
    flex: 1;
    min-width: 10rem;
    accent-color: var(--accent);
  }
  .readouts {
    display: flex;
    gap: 1.25rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
</style>
