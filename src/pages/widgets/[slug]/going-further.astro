---
import { getCollection, getEntry, render } from 'astro:content';
import DeepDiveLayout from '../../../layouts/DeepDiveLayout.astro';

export async function getStaticPaths() {
  const deepDives = await getCollection('deepDives');
  return deepDives.map((entry) => ({ params: { slug: entry.slug } }));
}

const { slug } = Astro.params;
const deepDive = await getEntry('deepDives', slug);
if (!deepDive) throw new Error(`Missing deep-dive content for "${slug}"`);
const widget = await getEntry('widgets', slug);
const { Content } = await render(deepDive);

const backHref = `${import.meta.env.BASE_URL}widgets/${slug}/`;
const backLabel = widget ? widget.data.title : 'the widget';
---

<DeepDiveLayout title={deepDive.data.title} description={deepDive.data.description} backHref={backHref} backLabel={backLabel}>
  <h1>{deepDive.data.title}</h1>
  <Content />
</DeepDiveLayout>
